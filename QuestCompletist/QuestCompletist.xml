  <Frame name="qcToast" toplevel="true" parent="QuestFrame" enableMouse="true" movable="false" hidden="true" frameStrata="MEDIUM">
    <Size x="256" y="64"/>
    <Anchors>
      <Anchor point="TOP" relativePoint="BOTTOM" relativeTo="QuestFrame" x="0" y="-40"/>
    </Anchors>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentBackground" file="Interface/UnitPowerBarAlt/Generic1Player_Horizontal_Bgnd">
          <Size x="256" y="64"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture name="$parentBorder" file ="Interface/UnitPowerBarAlt/WoodwithMetal_Horizontal_Frame">
          <Size x="256" y="64"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture name="$parentLogo" file="Interface/TUTORIALFRAME/UI-TutorialFrame-QuestGiver">
          <Size x="96" y="96"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-15" y="30"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentText" parentKey="qcToastText" text="Quest Completist" inherits="GameFontNormal" wordwrap="false">
          <Size x="256" y="64"/>
          <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnEnter>
        qcToast_OnEnter(self)
      </OnEnter>
      <OnLeave>
        qcToast_OnLeave(self)
      </OnLeave>
    </Scripts>
  </Frame>

  

  <Frame name="qcNewDataAlert" toplevel="true" parent="QuestFrame" enableMouse="true" movable="false" hidden="true" frameStrata="High"> --Changed from Medium to make the dialog box show
    <Size x="250" y="16"/>
    <Anchors>
      <Anchor point="TOP" relativePoint="TOP" relativeTo="QuestFrame" x="15" y="-35"/> -- x moves text right
    </Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentIcon" parentKey="qcNewDataAlertIcon" atlas="QuestNormal">
          <Size x="16" y="16"/>
          <Anchors>
            <Anchor point="LEFT"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString name="$parentText" parentKey="qcNewDataAlertText" text="Updated Data Found - Please Contribute!" inherits="GameFontHighlightSmall" wordwrap="false" justifyH="LEFT">
          <Size x="230" y="16"/>
          <Anchors>
            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentIcon"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnEnter>
        qcNewDataAlert_OnEnter(self)
      </OnEnter>
      <OnLeave>
        qcNewDataAlert_OnLeave(self)
      </OnLeave>
    </Scripts>
  </Frame>

